{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sem.cmd.v1",
  "title": "Smart Energy Manager - comando (conteudo de 'payload' do envelope)",
  "type": "object",
  "required": ["schema", "id", "ts_ms", "ttl_s", "type", "args"],
  "properties": {
    "schema": {"const": "sem.cmd.v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 40},
    "ts_ms": {"type": "integer", "minimum": 0},
    "ttl_s": {"type": "integer", "minimum": 1, "maximum": 3600},
    "type": {"enum": ["set_mode", "set_loads", "sync_soc", "reset_faults"]},
    "args": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "set_mode"}}},
     "then": {"properties": {"args": {"type": "object", "required": ["mode"],
       "properties": {"mode": {"enum": ["conventional", "rules", "predictive"]}}, "additionalProperties": false}}}},
    {"if": {"properties": {"type": {"const": "set_loads"}}},
     "then": {"properties": {"args": {"type": "object", "required": ["loads"], "additionalProperties": false,
       "properties": {"loads": {"type": "array", "minItems": 1, "maxItems": 8, "items": {
         "type": "object", "required": ["id", "on", "duty"], "additionalProperties": false,
         "properties": {"id": {"type": "integer", "minimum": 1}, "on": {"type": "boolean"},
                        "duty": {"type": "number", "minimum": 0, "maximum": 1}}}}}}}}},
    {"if": {"properties": {"type": {"const": "sync_soc"}}},
     "then": {"properties": {"args": {"type": "object", "required": ["soc"], "additionalProperties": false,
       "properties": {"soc": {"type": "number", "minimum": 0, "maximum": 1}}}}}},
    {"if": {"properties": {"type": {"const": "reset_faults"}}},
     "then": {"properties": {"args": {"type": "object", "maxProperties": 0}}}}
  ]
}
