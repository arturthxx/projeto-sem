{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sem.cmd.envelope",
  "title": "Envelope autenticado de comando (topico smartenergy/cmd)",
  "type": "object",
  "required": ["payload", "hmac"],
  "additionalProperties": false,
  "properties": {
    "payload": {"type": "string", "minLength": 2, "maxLength": 1024},
    "hmac": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
